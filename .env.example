# =============================================================================
# Variables de entorno del Proyecto 2
# Copia este archivo como `.env` y completa los valores.
# .env NUNCA se sube al repositorio ni se incluye en el zip de entrega.
# =============================================================================

# --- MongoDB Atlas -----------------------------------------------------------
# Cadena de conexión del clúster (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos donde vive el catálogo
MONGODB_DB=nobel

# --- Autenticación JWT -------------------------------------------------------
# Secreto para firmar los tokens. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# --- Usuario administrador inicial (lo crea `npm run seed`) -----------------
SEED_ADMIN_EMAIL=admin@catalogo-nobel.test
SEED_ADMIN_PASSWORD=Nobel2026!

# --- Opcional: URL de la API ------------------------------------------------
# En producción se deja vacío: el frontend usa rutas relativas (/api).
# Solo se usa si la API vive en otro dominio.
# NUXT_PUBLIC_API_BASE=http://127.0.0.1:8787/api
